# Server
PORT=8787
DATABASE_PATH=./server/data/scarlet.db
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
ADMIN_EMAIL=admin@scarlet.demo
ADMIN_PASSWORD=replace-this-development-password

# Frontend — digits only. Leave blank until the store owner provides a real number.
VITE_WHATSAPP_NUMBER=

# Payments
# No live payment provider is enabled in this demo. Orders support cash on delivery
# and bank transfer/pending status only. Add provider credentials and verified
# webhook handlers before enabling online payment collection.
